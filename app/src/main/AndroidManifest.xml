<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      O motor de IA offline (LiteRT-LM) e uma biblioteca nativa. Se o AAR dele
      declarar um minSdk acima do 26 do app, esta linha impede que o build pare;
      o motor so e carregado quando a pessoa usa o modo offline e qualquer falha
      vira um aviso, o resto do app continua igual.
    -->
    <uses-sdk tools:overrideLibrary="com.google.ai.edge.litertlm" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Lista completa de apps em Ajustes > Apps em geral (inclusive os do
      sistema e os sem icone). Distribuido fora da Play Store; se um dia for
      publicado la, essa permissao exige declaracao de uso.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Aviso de versao nova (Android 13+ pede ao usuario). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Atualizar o proprio app sem sair dele: baixa o APK do release e o entrega ao
      instalador do Android, que ainda pede a confirmacao da pessoa. Na primeira vez
      ela tambem precisa permitir "instalar apps desconhecidos" para o TecladoIA.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- So usada em Android 9 ou anterior, para salvar o backup das funcoes
         direto na pasta Downloads publica (no 10+ o MediaStore dispensa isso). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Permite pedir a isencao de otimizacao de bateria pela tela do sistema,
         para o servico de acessibilidade nao ser encerrado em segundo plano. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Reconhecimento de fala via app de IME/assistente instalado no aparelho -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Lista de apps na tela "Apps de banco e pagamento" -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AiKeyboardApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiKeyboardAssistant">

        <!-- Bibliotecas do sistema que o motor offline pode usar para a GPU. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AiKeyboardAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity transparente usada apenas para pedir o microfone a partir do overlay -->
        <activity
            android:name=".ui.MicPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Transparent" />

        <service
            android:name=".service.KeyboardOverlayService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <!-- Resultado da instalacao da atualizacao, enviado pelo instalador do Android. -->
        <receiver
            android:name=".data.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
