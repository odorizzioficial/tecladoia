    <string name="about_app_1_title">An AI bar above your keyboard</string>
    <string name="about_app_1_body">The app doesn\'t replace your keyboard: it draws a bar right above it, with shortcuts to fix, improve, translate, change the tone, summarize, rewrite and dictate.</string>
    <string name="about_app_2_title">Works in any app</string>
    <string name="about_app_2_body">The bar shows up in any text field. You tap an action and the AI returns the text already applied, with Undo on the bar.</string>
    <string name="about_app_3_title">Your functions, your prompts</string>
    <string name="about_app_3_body">In Functions you create shortcuts with your own prompts, pick the emoji, reorder by dragging and pin your favorites.</string>
    <string name="about_app_4_title">With your own Gemini key</string>
    <string name="about_app_4_body">There is no middle server: the app talks straight to the Gemini API using the key you saved.</string>
    <string name="about_app_5_title">Positioning tip</string>
    <string name="about_app_5_body">If the bar covers a message, drag it by the handle on the left, or tap the down arrow to shrink everything into a small button.</string>

    <string name="about_perm_1_title">Knowing when the keyboard is open</string>
    <string name="about_perm_1_body">Android doesn\'t report the height of a third-party keyboard any other way. The service uses it to anchor the bar above the keys.</string>
    <string name="about_perm_2_title">Reading the focused field when you ask</string>
    <string name="about_perm_2_body">Reading only happens when you tap a shortcut, to send that text to the AI.</string>
    <string name="about_perm_3_title">Replacing the text after your action</string>
    <string name="about_perm_3_body">The swap uses Android\'s standard editing action and only runs after your tap.</string>
    <string name="about_perm_note">The app doesn\'t declare itself an accessibility tool, doesn\'t log keystrokes, doesn\'t record audio in the background and sends nothing to the internet without an action from you.</string>

    <string name="about_data_1_title">Text only leaves when you tap</string>
    <string name="about_data_1_body">No automatic action sends what you type: the AI receives the text only when you run a shortcut.</string>
    <string name="about_data_2_title">One destination: the Gemini API</string>
    <string name="about_data_2_body">The request goes straight to Gemini\'s server with your key. There is no app server in between, no analytics and no telemetry.</string>
    <string name="about_data_3_title">The key stays encrypted on the device</string>
    <string name="about_data_3_body">It is stored with AES/GCM 256 using a key generated in the Android Keystore, which never leaves the device.</string>
    <string name="about_data_4_title">Nothing is kept</string>
    <string name="about_data_4_body">The app keeps no history of the messages that pass through the bar: the text is used and discarded.</string>
    <string name="about_data_5_title">Voice handled by the system</string>
    <string name="about_data_5_body">Dictation uses Android\'s own recognizer. The audio isn\'t sent to Gemini, only the transcribed text.</string>

    <string name="about_blocked_1_title">Play Protect warned during install</string>
    <string name="about_blocked_1_body">This happens with every APK installed outside the Play Store, because it hasn\'t gone through Google\'s review. Tap More details and Install anyway.</string>
    <string name="about_blocked_2_title">Accessibility appeared blocked</string>
    <string name="about_blocked_2_body">Since Android 13, apps installed outside the store start with restricted settings off. Open the app info, tap the three dots and choose Allow restricted settings.</string>
    <string name="about_blocked_3_title">The service turns itself off</string>
    <string name="about_blocked_3_body">It is almost always battery saving killing the app in the background. Unrestrict it in Settings &gt; Permissions, under Unrestricted battery.</string>
