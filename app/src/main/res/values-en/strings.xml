    <string name="cl_120_1">Faster answers: internal reasoning off and output cap proportional to the text.</string>
    <string name="cl_120_2">Connection reused between actions and the key read from memory.</string>
    <string name="cl_120_3">Immediate feedback on tap and repeated taps blocked.</string>
    <string name="cl_120_4">Specific error messages, with a Try again button.</string>
    <string name="cl_120_5">Model list fetched from your key\'s API, cached per key.</string>
    <string name="cl_120_6">App translated into 10 languages.</string>
    <string name="cl_110_1">Shortcuts apply the text right away, with Undo on the bar.</string>
    <string name="cl_110_2">Real-time dictation, already corrected and without pasting the field placeholder.</string>
    <string name="cl_110_3">Draggable bar with saved position, and a minimized mode that frees the screen.</string>
    <string name="cl_110_4">Pull the bar down and the default shortcuts give way to your functions.</string>
    <string name="cl_110_5">Functions reordered by dragging the card, with a full emoji picker.</string>
    <string name="cl_110_6">New menus in Settings: Gemini API Key, Appearance, Permissions and About.</string>
    <string name="cl_100_1">First release: an AI bar above the keyboard you already use.</string>
    <string name="cl_100_2">Fix, improve, translate, change tone, summarize, rewrite and voice dictation.</string>
    <string name="cl_100_3">Custom functions with your own prompts, pinnable to the bar.</string>
    <string name="cl_100_4">Gemini key encrypted on the device, with no middle server.</string>

