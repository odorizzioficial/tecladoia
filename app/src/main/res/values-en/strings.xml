    <string name="welcome_title">Welcome to TecladoIA</string>
    <string name="welcome_body">Before you start, allow what the app uses. You can change everything later in Settings &gt; Permissions.</string>
    <string name="welcome_continue">Continue</string>
    <string name="welcome_note">You can go on without allowing everything: the microphone is only needed for dictation, and the battery setting keeps the service from being killed.</string>
